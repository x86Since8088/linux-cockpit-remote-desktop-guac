+
+static gboolean
+on_handle_take_client (GrdDBusRemoteDesktopRdpHandover *interface,
+                       GDBusMethodInvocation           *invocation,
+                       GUnixFDList                     *list,
+                       GrdRemoteClient                 *remote_client)
+{
+  g_assert (interface == remote_client->handover_dst->interface);
+
+  g_debug ("[DaemonSystem] At: %s, received TakeClient call",
+           remote_client->handover_dst->object_path);
+
+  /* edt1 fix (KNOWN_ISSUES I29): the TakeClientReady signal is not deliverable on
+   * this host's D-Bus, so the handover daemon calls TakeClient proactively -- often
+   * BEFORE the client has reconnected. Hold the invocation until the reconnect
+   * (on_incoming_redirected_connection) supplies socket_connection; if the client
+   * already reconnected, complete it immediately. */
+  if (remote_client->pending_take_client_invocation)
+    {
+      /* audit S(low): never orphan an already-stored invocation on a duplicate/early
+       * TakeClient -- error the new one instead of overwriting the slot (which would
+       * leak the first invocation into a 25s D-Bus timeout). */
+      g_dbus_method_invocation_return_error_literal (invocation,
+                                                     G_DBUS_ERROR,
+                                                     G_DBUS_ERROR_FAILED,
+                                                     "TakeClient already pending");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  remote_client->pending_take_client_invocation = invocation;
+  if (remote_client->socket_connection)
+    complete_take_client (remote_client);
 
   return G_DBUS_METHOD_INVOCATION_HANDLED;
 }
