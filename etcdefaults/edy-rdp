# /etc/default/edy-rdp — cockpit-guac-rdp relay configuration (EnvironmentFile).
# Installed by install.sh from source/etcdefaults/edy-rdp. An existing file is
# PRESERVED on upgrade (edit it freely). Apply changes with:
#     systemctl restart edy-rdp-relay.service
#
# The relay service ships built-in defaults identical to the values below, so this
# file is optional — it exists so an operator can tune the relay without editing the
# systemd unit.

# guacd endpoint the relay dials (host:port). guacd binds host loopback and is
# gated to the relay uid by nftables — do NOT expose it on a routable address.
EDY_RDP_GUACD=127.0.0.1:4822

# Unix group whose members are treated as Cockpit administrators for the
# server-side console gate (the elevation-proven token is still required).
EDY_RDP_ADMIN_GROUP=sudo

# Where the relay persists its session registry (tmpfs; does not survive reboot,
# which is correct since live guacd/grd sessions do not either).
EDY_RDP_STATE_FILE=/run/edy-rdp/state/sessions.json

# Log verbosity for the relay + the edy-rdp-trace logger (DEBUG|INFO|WARNING|ERROR).
EDY_RDP_LOG_LEVEL=INFO

# RDP targets guacd is permitted to dial (SSRF-class allow-list). Space-separated
# --allow-target flags; word-split into args by systemd. grd backend ports only.
EDY_RDP_ALLOW_ARGS=--allow-target 127.0.0.1:3389 --allow-target 127.0.0.1:3390 --allow-target 127.0.0.1:3391

# Pinned guacd container image (edy-rdp-guacd.service reads this too).
GUACD_IMAGE=docker.io/guacamole/guacd:1.6.0

# --- Remote-host RDP ("Remote host" scenario: jump into another RDP host) --------
# Which remote hosts the relay may RDP into. This is a SEPARATE, FAIL-CLOSED
# allow-list (empty = the feature is OFF / deny-all). It is the SSRF control: the
# user picks the target in the browser, but the relay only dials hosts listed here.
# Comma/space separated IPv4 or CIDR, each optionally :port (default 3389, :* = any
# port). The literal 'any' allows any host (use with care). IPv4 only. Examples:
#   EDY_RDP_REMOTE_ALLOW=192.168.2.0/24            # that subnet, port 3389
#   EDY_RDP_REMOTE_ALLOW=192.168.2.20:3389,10.0.0.5:3390
#   EDY_RDP_REMOTE_ALLOW=any:*                     # anywhere, any port (SSRF-open)
EDY_RDP_REMOTE_ALLOW=

# Set to 1 to require Cockpit administrative access for the remote scenario.
EDY_RDP_REMOTE_ADMIN_ONLY=0
