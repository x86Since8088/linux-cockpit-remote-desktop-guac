# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# staging / package build roots
/stage/
/DESTDIR/
*.deb
*.rpm

# node / playwright (the browser harness lives outside this repo, but guard anyway)
node_modules/
/test-results/
/playwright-report/

# deployment scratch (container/VM provisioning artifacts, cloud-init, keys)
/deploy/tmp/
*.qcow2
*.img
cloud-init*.iso
*.pem
*.key.local

# editor / OS cruft
.DS_Store
*.swp
*~
.idea/
.vscode/

# A .env is a DEPLOYED file: it belongs at [install path]/.env, seeded from the
# committed .envdefault by deploy.sh, missing-only. One in the source tree exists
# ONLY for running tests during development and must never be what a deployed
# plugin reads -- so it is never committed, at any depth. (.envdefault IS
# committed: it is the seed, not the configuration.)
.env
**/.env
