// polkit: let the edy-relay service account start/stop ONLY the per-user
// headless isolated-session units, so the SO_PEERCRED relay can bring a
// caller's own session up on demand -- with no broader privilege.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "edy-relay") {
        var unit = action.lookup("unit");
        if (unit && (unit.indexOf("edy-rdp-headless@") === 0 ||
                     unit.indexOf("edy-rdp-waylandvnc@") === 0 ||
                     unit.indexOf("edy-rdp-deskui@") === 0 ||
                       unit.indexOf("edy-rdp-unlock@") === 0 ||
                     // Self-update: EXACT names, not a prefix match -- these two
                     // units are deliberately NOT templated (no %i instance at
                     // all), one step more robust than the %i families above.
                     // "apply"/"rollback" take no caller-influenced data of any
                     // kind, so an exact match is both correct and sufficient.
                     unit === "edy-rdp-selfupdate-apply.service" ||
                     unit === "edy-rdp-selfupdate-rollback.service")) {
            return polkit.Result.YES;
        }
    }
});
