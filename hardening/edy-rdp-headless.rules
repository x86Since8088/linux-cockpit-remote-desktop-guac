// polkit: let the edy-relay service account start/stop ONLY the per-user
// headless isolated-session units, so the SO_PEERCRED relay can bring a
// caller's own session up on demand -- with no broader privilege.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "edy-relay") {
        var unit = action.lookup("unit");
        if (unit && (unit.indexOf("edy-rdp-headless@") === 0 ||
                     unit.indexOf("edy-rdp-waylandvnc@") === 0 ||
                     unit.indexOf("edy-rdp-deskui@") === 0 ||
                       unit.indexOf("edy-rdp-unlock@") === 0 ||
                     // Dependency-tracking rollback: EXACT name, not a prefix
                     // match -- this unit is deliberately NOT templated (no %i
                     // instance at all), the same stronger property
                     // edy-rdp-rotate-rdplogin.service already uses elsewhere
                     // in this project.
                     unit === "edy-rdp-depcheck-rollback.service")) {
            return polkit.Result.YES;
        }
    }
});
