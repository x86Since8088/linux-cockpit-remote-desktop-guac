[Unit]
# Documentation= is deliberately absent: it used to name
# file:///usr/share/cockpit/guac-rdp/README.md, which no installer has ever
# put there. A dangling Documentation= is a stale comment with a URL scheme.
# The docs live in the repository under docs/.
Description=edy-rdp guacd relay (SO_PEERCRED auth, per-user UUID binding, console gate, keepalive)
Requires=edy-rdp-relay.socket edy-rdp-control.socket edy-rdp-guacd.service
After=edy-rdp-relay.socket edy-rdp-control.socket edy-rdp-guacd.service

[Service]
Type=simple
User=edy-relay
Group=edy-rdp
# Runs as the dedicated edy-relay uid so the nftables owner-match on 127.0.0.1:4822
# admits THIS process and drops every other local uid.
#
# The bootstrap runs FIRST and as ROOT: '+' means full privileges - exempt from the
# User=, NoNewPrivileges= and ProtectSystem= lines below (systemd.service(5)), which
# is what lets it write @INSTALL_PATH@/venv and venv.env. It validates the .env
# (fail closed: a relay on defaults it was never configured with is worse than one
# that did not start), verifies the OS prerequisites from requires.txt, and builds or
# refreshes the venv OFFLINE from the vendored wheels. It never installs a package:
# that changes host state and belongs to deploy.sh --with-deps.
ExecStartPre=+@LIBEXEC@/edy-rdp-bootstrap
# Config comes from the .env named below; these Environment= lines are the
# documented built-in fallbacks for anything that file does not set.
# The payload is immutable: no bytecode cache is written into it.
Environment=PYTHONDONTWRITEBYTECODE=1
# The interpreter. /usr/bin/python3 is the documented fallback; venv.env (written by
# the bootstrap, read last below so it wins) points at @INSTALL_PATH@/venv/bin/python3
# once requirements.txt names a dependency. systemd will not take a variable as the
# program itself ("the first argument may not be a variable"), so /usr/bin/env execs it.
Environment=EDY_RDP_PYTHON=/usr/bin/python3
Environment=EDY_RDP_GUACD=127.0.0.1:4822
Environment=EDY_RDP_ADMIN_GROUP=sudo
# Additional gate for mirroring a DIFFERENT signed-in user's console session
# (admin-only gating above is unchanged). Empty = this extra gate is off.
Environment=EDY_RDP_SHADOW_GROUP=rdp-shadow
Environment=EDY_RDP_STATE_FILE=/run/edy-rdp/state/sessions.json
Environment=EDY_RDP_LOG_LEVEL=INFO
Environment="EDY_RDP_ALLOW_ARGS=--allow-target 127.0.0.1:3389 --allow-target 127.0.0.1:3390 --allow-target 127.0.0.1:3391"
# Remote-host RDP: empty allow-list = feature OFF / deny-all (fail closed). The
# fallback below guarantees the flag is bound even on an upgraded host whose
# migrated .env predates these vars.
Environment=EDY_RDP_REMOTE_ALLOW=
Environment=EDY_RDP_REMOTE_ADMIN_ONLY=0
# Desktop-UI control WRITE actions (enable/disable/start/stop the graphical
# desktop) are OFF unless the host opts in. Empty/0 = status is still readable but
# no write verb runs (fail closed). NEVER set this on an operator's own
# workstation: a Stop there would kill the local session.
Environment=EDY_RDP_DESKUI_ENABLE=0
# Self-update: which GitHub repo to check for a newer tagged Release. A
# location, not a flag -- read straight from the process environment (this
# EnvironmentFile mechanism), never passed on the ExecStart line below.
Environment=EDY_RDP_UPDATE_REPO=x86Since8088/linux-cockpit-remote-desktop-guac
# NOT optional (no leading '-'): a relay running on built-in defaults it was
# never configured with is worse than a relay that did not start. install.sh
# places this file from .envdefault, reconciles it on upgrade and validates it
# before it renders this unit; the bootstrap above validates it again at every
# start. The Environment= lines above remain the documented fallbacks.
EnvironmentFile=@ENV_FILE@
# Optional ('-'): absent until the bootstrap has run once. Read AFTER the .env so
# the interpreter the bootstrap chose wins over the fallback above.
EnvironmentFile=-@INSTALL_PATH@/venv.env
# ${VAR} expands to one argument; $EDY_RDP_ALLOW_ARGS (no braces) is word-split into
# the repeated --allow-target flags. ${EDY_RDP_REMOTE_ALLOW} MUST be braced (one arg):
# it is a comma-list, not word-split flags.
ExecStart=/usr/bin/env ${EDY_RDP_PYTHON} @LIBEXEC@/edy_rdp_relay.py \
    --guacd ${EDY_RDP_GUACD} --admin-group ${EDY_RDP_ADMIN_GROUP} \
    --shadow-group ${EDY_RDP_SHADOW_GROUP} \
    --state-file ${EDY_RDP_STATE_FILE} \
    $EDY_RDP_ALLOW_ARGS \
    --remote-allow ${EDY_RDP_REMOTE_ALLOW} \
    --remote-admin-only ${EDY_RDP_REMOTE_ADMIN_ONLY} \
    --deskui-write ${EDY_RDP_DESKUI_ENABLE} \
    --log-level ${EDY_RDP_LOG_LEVEL}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/edy-rdp
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
Restart=on-failure

[Install]
WantedBy=multi-user.target
