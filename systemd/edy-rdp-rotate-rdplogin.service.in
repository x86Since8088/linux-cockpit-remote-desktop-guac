[Unit]
Description=edy-rdp rotate the 3390 Remote-Login (rdplogin) door credential
After=gnome-remote-desktop.service
Wants=gnome-remote-desktop.service

[Service]
Type=oneshot
ExecStart=@LIBEXEC@/edy-rdp-rotate-rdplogin
# EDY_RDP_DOOR_USER comes from here; the door KEY never does - it lives in
# grd's own credential store and this unit rotates it there.
EnvironmentFile=@ENV_FILE@
# writes the system grd credential + restarts the system daemon; needs root
