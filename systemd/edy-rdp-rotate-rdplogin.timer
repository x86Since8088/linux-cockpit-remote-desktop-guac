[Unit]
Description=edy-rdp periodic rotation of the 3390 rdplogin door credential

[Timer]
# Rotate daily (on the next idle run); catch up if the machine was off.
OnCalendar=daily
# Also rotate ~10 min after boot so a fresh key follows every restart.
OnBootSec=10min
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
