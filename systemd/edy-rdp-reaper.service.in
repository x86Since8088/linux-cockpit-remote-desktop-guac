[Unit]
# Documentation= is deliberately absent: it used to name
# file:///usr/share/cockpit/guac-rdp/README.md, which no installer has ever
# put there. A dangling Documentation= is a stale comment with a URL scheme.
# The docs live in the repository under docs/.
Description=edy-rdp session reaper (prune registry; close idle greeters after 60s)
After=edy-rdp-control.socket edy-rdp-relay.service
Wants=edy-rdp-control.socket

[Service]
Type=oneshot
# The interpreter: /usr/bin/python3 unless venv.env (written by the relay's
# bootstrap; optional here, hence '-') names the venv. Why /usr/bin/env and why
# the fallback: see edy-rdp-relay.service. No ExecStartPre of its own - if the
# bootstrap never ran there is no venv.env and the fallback python runs.
Environment=EDY_RDP_PYTHON=/usr/bin/python3
EnvironmentFile=-@INSTALL_PATH@/venv.env
ExecStart=/usr/bin/env ${EDY_RDP_PYTHON} @LIBEXEC@/edy_rdp_reaper.py --control /run/edy-rdp/control.sock --greeter-ttl 60 --ephemeral-ttl 15
# The payload is immutable: no bytecode cache is written into it.
Environment=PYTHONDONTWRITEBYTECODE=1
User=root
NoNewPrivileges=yes
